# =========================================================================
# AlgoTradingDaily Environment Configuration (Example)
# =========================================================================

# OpenAlgo Unified OMS Gateway
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_WS_URL=ws://127.0.0.1:8765
OPENALGO_API_KEY=your_openalgo_api_key

# Telegram Real-Time Telemetry Alerts
#
# Required for the long-polling bot process (`python -m alerts.tg_bot`):
#   TELEGRAM_BOT_TOKEN    Bot token from @BotFather.
#   TELEGRAM_INVITE_CODE  Shared secret you give to paying subscribers.
#
# Optional:
#   TELEGRAM_CHAT_ID       If set, this chat_id is auto-subscribed on first
#                          bot startup for backward compatibility with the
#                          original single-user deployment.
#   TELEGRAM_OWNER_CHAT_ID Your own numeric chat_id. If set, owner-only admin
#                          commands (/subscribers, /pending, /revoke,
#                          /reinstate, /ban) become available in your chat.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_INVITE_CODE=your_invite_code
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_OWNER_CHAT_ID=

# Trading Universe: NIFTY50 (50 stocks) or NIFTY200 (200 stocks)

# Shoonya (Finvasia / Noren) Direct API -- used by data_pipeline.shoonya_mcx
# for MCX commodity historical ingestion (`python -m data_pipeline.shoonya_mcx`).
#   SHOONYA_USER_ID     Broker login id (e.g. A123456).
#   SHOONYA_SUSERTOKEN  Optional live session token. Since Shoonya's 2026 OAuth
#                       migration retired vendor QuickAuth, sessions must come
#                       from the OAuth flow. Preferred source is the OpenAlgo
#                       checkout below (its DB is read automatically); set this
#                       var only to override with a hand-copied token.
#   OPENALGO_DIR        Path to the co-hosted OpenAlgo checkout. Its .env (for
#                       the Fernet key material) and db/openalgo.db (for the
#                       susertoken minted by Shoonya's OAuth login) are read;
#                       when the token expires, re-login via the OpenAlgo web UI.
#   SHOONYA_HOST        API base (default https://api.shoonya.com/NorenWClientAPI/).
#                       The legacy /NorenWClientTP/ path is decommissioned (502).
SHOONYA_USER_ID=your_shoonya_user_id
SHOONYA_SUSERTOKEN=
OPENALGO_DIR=/home/ubuntu/openalgo

