# =============================================================
# BROKER CREDENTIALS & SECRETS (CONFIDENTIAL)
# Copy this file to .env and fill in your actual private credentials.
# NEVER commit your actual .env file to version control.
# =============================================================

# --- [1] Finvasia Shoonya ---
SHOONYA_USER=your_user_id
SHOONYA_PWD=your_password
SHOONYA_API_KEY=your_api_key
SHOONYA_VENDOR_CODE=your_vendor_code
SHOONYA_TOTP_KEY=your_totp_secret_key
SHOONYA_IMEI=shoonya_algo_desktop

# --- [1b] OpenAlgo historical-data ingestion ---
# Base URL of your self-hosted OpenAlgo server (never commit a personal endpoint).
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_API_KEY=your_openalgo_api_key
# Set true only when your OpenAlgo broker needs NSE cash symbols such as RELIANCE-EQ.
OPENALGO_SHOONYA_APPEND_EQ=false

# --- [2] Zerodha Kite Connect ---
ZERODHA_USER_ID=your_user_id
ZERODHA_PASSWORD=your_password
ZERODHA_API_KEY=your_api_key
ZERODHA_API_SECRET=your_api_secret
ZERODHA_TOTP_KEY=your_totp_secret_key

# --- [3] Dhan HQ ---
DHAN_CLIENT_ID=your_client_id
DHAN_ACCESS_TOKEN=your_access_token

# --- [4] Groww API ---
GROWW_USER_ID=your_user_id
GROWW_API_KEY=your_api_key
GROWW_API_SECRET=your_api_secret

# --- [5] Angel One SmartAPI ---
ANGELONE_CLIENT_CODE=your_client_code
ANGELONE_PASSWORD=your_password
ANGELONE_API_KEY=your_api_key
ANGELONE_TOTP_KEY=your_totp_secret_key

# --- [6] Upstox API v2 ---
UPSTOX_API_KEY=your_api_key
UPSTOX_API_SECRET=your_api_secret
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/callback

# --- [7] Fyers API v3 ---
FYERS_APP_ID=your_app_id
FYERS_ACCESS_TOKEN=your_access_token

# =============================================================
# NOTIFICATION & ALERT SECRETS (OPTIONAL)
# =============================================================
# --- Telegram Bot Alerts ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
