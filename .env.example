# =========================================================================
# AlgoTradingDaily Environment Configuration (Example)
# =========================================================================

# OpenAlgo Unified OMS Gateway
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_WS_URL=ws://127.0.0.1:8765
OPENALGO_API_KEY=your_openalgo_api_key

# Telegram Real-Time Telemetry Alerts
#
# Required for the long-polling bot process (`python -m alerts.tg_bot`):
#   TELEGRAM_BOT_TOKEN    Bot token from @BotFather.
#   TELEGRAM_INVITE_CODE  Shared secret you give to paying subscribers.
#
# Optional:
#   TELEGRAM_CHAT_ID       If set, this chat_id is auto-subscribed on first
#                          bot startup for backward compatibility with the
#                          original single-user deployment.
#   TELEGRAM_OWNER_CHAT_ID Your own numeric chat_id. If set, owner-only admin
#                          commands (/subscribers, /pending, /revoke,
#                          /reinstate, /ban) become available in your chat.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_INVITE_CODE=your_invite_code
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_OWNER_CHAT_ID=

# Trading Universe: NIFTY50 (50 stocks) or NIFTY200 (200 stocks)
